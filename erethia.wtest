import rolando.*
describe "tests de erethia" {
    test "test parte 1.1" {
        rolando.vaciarMochila()
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(rolando.capacidadMaxima(), rolando.artefactosDeLaMochila().size())
        rolando.artefactosDeLaMochila()
    }

    test "test parte 1.2" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.llegarACastillo()
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarACastillo()
        castilloDePiedra.artefactosEnElCastillo()
    }

    test "test parte 1.3" {
        rolando.encuentraArtefacto(collarDivino)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.llegarACastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.artefactosDeRolando()
        assert.throwsException({rolando.tieneElArtefacto(libroDeHechizos)})

    }

    test "test parte 1.4" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarACastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)

    }
}